{
  "expo": {
    "name": "Shuttle Booking",
    "slug": "shuttle-booking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "notification": {
      "color": "#3c43ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.shuttlebooking.com",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "android.permission.NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "shuttlebooking"
  }
}
