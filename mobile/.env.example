# Variabili locali usate da Expo/dev build in sviluppo.
# Le build remote EAS leggono invece gli environment configurati nel dashboard Expo/EAS.

# Backend API (telefono/emulatore -> API locale)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000
#EXPO_PUBLIC_API_URL=https://YOUR_API_HOST/api

# Google Sign-In nativo: usa il Web OAuth Client ID, identico a quello
# consentito dal backend per la verifica dell'audience del token.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# iOS è disabilitato finché non sono disponibili GoogleService-Info.plist
# e la configurazione OAuth iOS. Metti true solo quando hai configurato entrambi.
EXPO_PUBLIC_GOOGLE_SIGN_IN_IOS_ENABLED=false

# Per EAS imposta GOOGLE_SERVICES_JSON (Android) e, se abiliti iOS,
# GOOGLE_SERVICE_INFO_PLIST come environment variable di tipo File.
# Non inserire segreti o contenuti dei file in questo .env.

# Aggiornamenti app (opzionale)
EXPO_PUBLIC_UPDATE_JSON_URL=http://YOUR_LAN_IP:5000/update.json
