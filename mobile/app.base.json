{
  "expo": {
    "name": "Shuttle Booking",
    "slug": "shuttle-booking-mobile",
    "version": "5",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "notification": {
      "color": "#3c43ff"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.shuttlebooking.com",
      "versionCode": 5,
      "permissions": ["android.permission.NOTIFICATIONS"]
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "shuttlebooking",
    "extra": {
      "eas": {
        "projectId": "92c02385-2b1b-477c-8744-f6becd0a7944"
      }
    }
  }
}
