# Copia questo file in backend/.env (gitignored) e valorizza le variabili.
# Letto automaticamente da `docker compose` quando eseguito da backend/.

# Password dell'utente "sa" di SQL Server. Deve rispettare i requisiti di
# complessita di SQL Server (min 8 caratteri, almeno 3 tra maiuscole,
# minuscole, cifre, simboli).
DB_SA_PASSWORD=

# Chiave di firma HMAC-SHA256 per i JWT. Genera un valore casuale forte, es.:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Solo per docker-compose-nas.yml (deploy con Traefik + Let's Encrypt).
LETSENCRYPT_EMAIL=
CF_DNS_API_TOKEN=
