# Copia questo file in backend/.env (gitignored) e valorizza le variabili.
# Letto automaticamente da `docker compose` quando eseguito da backend/.

# Password dell'utente "sa" di SQL Server. Deve rispettare i requisiti di
# complessita di SQL Server (min 8 caratteri, almeno 3 tra maiuscole,
# minuscole, cifre, simboli).
DB_SA_PASSWORD=

# Chiave di firma HMAC-SHA256 per i JWT. Genera un valore casuale forte, es.:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Google OAuth: Web client ID usato anche dall'app mobile per ottenere l'ID
# token. Non e' un segreto, ma deve corrispondere a un audience autorizzato dal
# backend. Per piu' audience usa GoogleAuth__ClientIds nell'ambiente del deploy.
GOOGLE_CLIENT_ID=CHANGE_ME_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Resend: chiave privata del provider email e mittente verificato nel relativo
# account. Non usare mai questi valori di esempio in produzione.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
RESEND_FROM_ADDRESS="ShuttleBooking <no-reply@CHANGE_ME_VERIFIED_DOMAIN>"

# URL pubblico assoluto opzionale del logo che compare nelle email. Lascia vuoto
# per mostrare la sola intestazione testuale.
EMAIL_LOGO_URL=

# Solo per docker-compose-nas.yml (deploy con Traefik + Let's Encrypt).
LETSENCRYPT_EMAIL=
CF_DNS_API_TOKEN=
